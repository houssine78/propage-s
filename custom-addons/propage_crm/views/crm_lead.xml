<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<record id="crm_lead_view_form" model="ir.ui.view">
	   <field name="name">crm.lead.form</field>
	   <field name="model">crm.lead</field>
	   <field name="inherit_id" ref="crm.crm_lead_view_form"/>
	   <field name="arch" type="xml">
	       <field name="active" position="after">
	           <field name="is_won" invisible="1"/>
	       </field>
	       <field name="tag_ids" position="after">
	           <field name="covention_file_name" invisible="True" />
	           <field name="convention_2c" filename="covention_file_name" />
	       </field>
	       <page name="internal_notes" position="before">
	           <page string="RW Timesheets" name="timesheet_matrix_tab">
                    <group name="timesheet" class="hr_timesheet_sheet_summary">
                        <field string="" name="timesheet_matrix_ids" widget="x2many_2d_matrix" readonly="1" field_x_axis="task_id" field_y_axis="year" field_value="amount">
                            <tree>
                                <field name="year"/>
                                <field name="task_id"/>
                                <field name="amount" widget="float_time" sum="Total"/>
                            </tree>
                        </field>
                    </group>
                </page>
	       </page>
	   </field>
	</record>
</odoo>