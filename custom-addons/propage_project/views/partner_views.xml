<odoo>
    <record id="view_partner_form_propage" model="ir.ui.view">
        <field name="name">res.partner.form.propage</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <page name="contact_addresses" position="after">
                <page string="FSE Time Logs" name="fse_time_logs">
                    <group>
	                    <group>
		                    <field name="time_fse_p1" widget="float_time"/>
		                    <field name="time_fse_p2" widget="float_time"/>
	                   </group>
	                   <group>
	                        <button name="action_create_fse_time_log_years" type="object" string="Generate years " class="btn-primary"/>
	                        <button name="action_recompute_time_participant" type="object" string="Recompute FSE time" class="btn-primary"/>
	                   </group>
                   </group>
                    <field name="fse_time_log_ids">
                        <tree create="false">
                            <field name="year"/>
                            <field name="time_fse_p1" widget="float_time"/>
                            <field name="time_fse_p2" widget="float_time"/>
                        </tree>
                    </field>
                </page>
                <page string="FSE Training" name="fse_training">
                    <field name="trainings" readonly="1">
                        <tree>
                            <field name="training_date"/>
                            <field name="task_id"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </page>
            <page name="sales_purchases" position="before">
                <page string="RW Timesheets" name="timesheet_matrix_tab">
                    <group name="timesheet" class="hr_timesheet_sheet_summary">
                        <field string="" name="timesheet_matrix_ids" widget="x2many_2d_matrix" readonly="1" field_x_axis="task_id" field_y_axis="year" field_value="amount">
                            <tree>
                                <field name="year"/>
                                <field name="task_id"/>
                                <field name="amount" widget="float_time" sum="Total"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>