<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="meeting_type_form_view" model="ir.ui.view">
        <field name="name">meeting.type.form</field>
        <field name="model">meeting.type</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Meeting Types">
                <sheet>
                    <group>
        	            <group>
        	               <field name="code" />
        	               <field name="name" />
        	            </group>
        	            <group>
        	            </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="meeting_type_tree_view" model="ir.ui.view">
        <field name="name">meeting.type.tree</field>
        <field name="model">meeting.type</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Meeting Types">
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="meeting_type_search_view" model="ir.ui.view">
        <field name="name">meeting.type.search</field>
        <field name="model">meeting.type</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Meeting Type">
                <field name="code" />
                <field name="name" />
	        </search>
	    </field>
    </record>

    <record id="action_meeting_type" model="ir.actions.act_window">
        <field name="name">Meeting types</field>
        <field name="res_model">meeting.type</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="meeting_type_tree_view" />
        <field name="search_view_id" ref="meeting_type_search_view" />
    </record>

    <menuitem
        id="menu_calendar_meeting_type"
        parent="calendar.calendar_menu_config"
        sequence="50"
        action="action_meeting_type"
        groups="propage_base.group_propage_user"/>
    
</odoo>