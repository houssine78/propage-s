<odoo>
    <record id="view_calendar_event_form" model="ir.ui.view">
        <field name="name">calendar.event.form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button icon="fa-bars" string="Register time" title="Register time"
                        type="action" name="%(action_view_calendar_time_registration_wizard)d" />
            </div>
            
            <field name="start_date" position="before">
                <field name="meeting_type_id" widget="selection"/>
            </field>
            <page name="page_invitations" position="before">
	            <page name="timesheets">
	                <field name="timesheet_ids" readonly="True">
	                   <tree editable="top" create="false" delete="false">
	 	                    <field name="date"/> 
	 	                    <field name="project_id"/>
	 	                    <field name="task_id"/>
		                    <field name="is_fse" />
	                        <field name="timesheet_type" />
	                        <field name="customer_id" />
		                    <field name="employee_id"/>
		                    <field name="unit_amount" widget="timesheet_uom"/>
	                    </tree>
	                </field>
	            </page>
	            <page name="participants">
                    <field name="participant_ids" readonly="True">
                        <tree editable="top" create="false" delete="false">
	                        <field name="training_date"/>
	                        <field name="participant_id"/>
	                        <field name="state"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>